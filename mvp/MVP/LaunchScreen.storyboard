<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="32700" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES" initialViewController="launch-view-controller">
    <device id="retina6_5" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22685"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen — full-bleed Hearth LaunchHero image on a cream canvas.-->
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-view-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" translatesAutoresizingMaskIntoConstraints="NO" image="LaunchHero" id="launch-hero"/>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <!-- cream canvas — visible at the edges only if the image doesn't fully cover -->
                        <color key="backgroundColor" red="0.9529411764705882" green="0.9411764705882353" blue="0.9215686274509804" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <!-- Pin the hero to all four edges, full-bleed (ignores safe area). -->
                            <constraint firstItem="launch-hero" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="constraint-leading"/>
                            <constraint firstItem="launch-hero" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="constraint-trailing"/>
                            <constraint firstItem="launch-hero" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="constraint-top"/>
                            <constraint firstItem="launch-hero" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="constraint-bottom"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchHero" width="752" height="1584"/>
    </resources>
</document>
