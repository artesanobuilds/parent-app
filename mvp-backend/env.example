# ─────────────────────────────────────────────────────────────────────────────
# MVP backend environment — canonical catalog.
# Copy to `.env` (gitignored) for local dev; set the prod values in Railway.
# A var left unset falls back to the code default noted in the comment; secrets
# have NO safe default and must be set before the relevant feature works.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / search (required for chat, research, moderation) ──────────────────
OPENAI_API_KEY=your_openai_api_key           # secret; sk-proj-* spends per-project budget
OPENAI_MODEL_NAME=gpt-5.5-2026-04-23         # runtime model (see reference_cost_logging)
OPENAI_MODERATION_MODEL=omni-moderation-latest
TAVILY_API_KEY=your_tavily_api_key           # secret; web search for research

# ── Voice (ElevenLabs ConvAI v2) ────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key   # secret
ELEVENLABS_AGENT_ID=                          # kid companion agent id
ELEVENLABS_PARENT_AGENT_ID=                   # parent coach agent id
ELEVENLABS_CONVAI_SECRET=                     # secret; Custom-LLM auth header

# ── Auth v2 (LIVE: Apple/Google Sign-In, JWT access + rotating refresh) ─────
AUTH_JWT_SECRET=                               # secret; HS256 signing key for access tokens (REQUIRED in prod)
AUTH_ACCESS_TTL_MIN=30                         # JWT access-token lifetime (minutes)
AUTH_ISSUE_TOKEN_ENABLED=1                     # 1=legacy /auth/issue-token still mints; flip to 0 at T2 (→410)
AUTH_LEGACY_TOKENS_ENABLED=1                   # 1=current_user still accepts legacy opaque tokens; 0=JWT-only
AUTH_TOKEN_TTL_DAYS=30                         # legacy opaque-token lifetime (dies at T2 + this TTL)
# /auth/issue-token now refuses already-claimed accounts (403) and is gated by
# AUTH_ISSUE_TOKEN_ENABLED. Prod runs 60/IP/hr (root CLAUDE.md); code default aligned.
RATE_LIMIT_AUTH_PER_HOUR=60
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_CONFIG_PER_MIN=30
RATE_LIMIT_RESEARCH_PER_HOUR=20

# ── Admin / CMS operator gate ───────────────────────────────────────────────
ADMIN_TOKEN=your_admin_token                  # secret; unlocks /cms/* + /data/* (rotate on leak)
ADMIN_SESSION_TTL_SECONDS=43200               # CMS cookie-session lifetime (12h)
ADMIN_COOKIE_SECURE=1                          # 1=Secure cookie (prod); set 0 only for local http

# ── Security headers ────────────────────────────────────────────────────────
ENABLE_HSTS=0                                  # 1 in prod (HTTPS at Railway); 0 for local http
ALLOWED_ORIGINS=http://localhost:8904,http://localhost:5173,http://127.0.0.1:8904
TRUST_PROXY=0                                  # 1 ONLY behind a proxy that sets X-Forwarded-For

# ── Google OAuth (Gmail/Calendar integrations; Phase 2 adds login reuse) ────
GOOGLE_OAUTH_CLIENT_ID=                        # web-app client id
GOOGLE_OAUTH_CLIENT_SECRET=                    # secret
GOOGLE_OAUTH_REDIRECT_URI=                     # e.g. https://<host>/oauth/google/callback
APP_OAUTH_CALLBACK_SCHEME=mvparent             # iOS custom scheme for the callback 302
INTEGRATION_ENC_KEY=                           # secret; Fernet key — encrypts refresh tokens + signs state + admin cookie

# ── Push (APNs) ─────────────────────────────────────────────────────────────
APNS_AUTH_KEY=                                 # secret; the .p8 contents (or use _FILE)
APNS_AUTH_KEY_FILE=                            # path to the .p8 (alternative to _AUTH_KEY)
APNS_KEY_ID=                                   # e.g. K97TDFQ2UM
APNS_TEAM_ID=                                  # e.g. 5K4ZDG6NFD
APNS_BUNDLE_ID=MVP.MVParent
APNS_USE_SANDBOX=0                             # 1=sandbox; TestFlight uses PRODUCTION (0)

# ── Email (debug reports + notifications over SMTP) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                                 # secret
SMTP_FROM=
DEBUG_REPORT_TO=                               # where in-app debug reports are mailed

# ── Observability (all no-op when unset) ────────────────────────────────────
SENTRY_DSN=                                    # errors; unset = disabled
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=                   # metrics → Grafana Cloud; unset = disabled
OTEL_EXPORTER_OTLP_HEADERS=                    # Basic-auth ingest token (see grafana-observability-setup.md)
OTEL_SERVICE_NAME=mvp-backend
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
SLACK_WEBHOOK_URL=                             # moderation/crisis alerts; unset = disabled

# ── Consent / misc ──────────────────────────────────────────────────────────
CONSENT_AGREEMENT_VERSION=closed-beta-v1-2026-05
PUBLIC_BASE_URL=                               # https base for share links (fast-follow)
DEBUG_ALL_LOGS=0
MVP_DUCKDB_PATH=                               # override DB path (tests set a temp file)

# ── Research worker + model tuning (sensible defaults in code) ──────────────
RESEARCH_WORKER_CONCURRENCY=5
RESEARCH_LLM_MAX_RETRIES=
RESEARCH_LLM_TIMEOUT_S=
RESEARCH_RECURSION_LIMIT=
RESEARCH_TAVILY_MAX_RESULTS=
RESEARCH_MODEL=
COS_MODEL=

# ── PostHog analytics + flags + experiments (LIVE, project 505309) ──────────
# All no-op when unset. Backend + dashboard + iOS clients all wired.
POSTHOG_API_KEY=                               # project key (public-by-design); also iOS Info.plist + Dockerfile ARG
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=                      # secret; feature_flag:read (local eval) + person:write (delete-my-data)
POSTHOG_PROJECT_ID=505309
VITE_POSTHOG_KEY=                              # dashboard build (Vite inlines at Docker build time)
ANALYTICS_STRICT=0                             # 1 in tests: raise on unknown event names

# ── Phase 4 (at-rest encryption) — set when encryption lands ────────────────
# DUCKDB_ENCRYPTION_KEY=                       # secret; 32-byte base64. LOSE THIS = LOSE THE VOLUME.
