.DS_Store
.venv/
.env
.env.*
xcuserdata/
DerivedData/
__pycache__/
*.pyc
mvp-backend/data/*.duckdb
mvp-backend/data/*.duckdb.wal
# Durable LangGraph agent checkpoints (app/checkpointing.py) — every parent's
# and kid's verbatim conversation. User state, never committed. SQLite in WAL
# mode also writes -wal/-shm siblings.
mvp-backend/data/agent_checkpoints.sqlite*
mvp-backend/data/.last-sync-summary.json
mvp-backend/data/.remote-checksums.json
mvp-backend/data/.sync-audit.log

# Runtime / user-state / credential parquets — never commit. Only the seed
# content parquets below are tracked.
mvp-backend/data/*.parquet
!mvp-backend/data/articles.parquet
!mvp-backend/data/categories.parquet
!mvp-backend/data/community_posts.parquet
!mvp-backend/data/mvp.parquet
!mvp-backend/data/post_replies.parquet
# ...and ANY parquet loose at the backend root. `export_parquet` writes relative
# to the CWD, so running it (or a test that calls it) from `mvp-backend/` rather
# than with MVP_DUCKDB_PATH set drops ~44 user-state files — auth_tokens,
# kid_credentials, invite_tokens — one directory ABOVE the ignored `data/`.
# 2026-08-08: that had happened and they were staged for commit.
mvp-backend/*.parquet

# Generated eval report dumps
mvp-backend/data/eval_reports/

# Pre-deploy prod snapshots (tools/backup-prod.sh output) — real family PII in
# parquet form. The LEDGER (docs/history/prod-backups.md) is the tracked
# record; the snapshot files themselves never are.
snapshots/

# Editor / agent tooling
.vscode/
.vix/
mvp-backend/.vix/
mvp/MVP/.vix/

# Secrets — never commit key material (APNs .p8, service-account keys, etc.).
# Ignore all .p8 anywhere + everything under secrets/ EXCEPT the README that
# documents the convention.
*.p8
mvp-backend/secrets/*
!mvp-backend/secrets/README.md
